{
  "name": "react-audio-book-reader",
  "version": "0.1.102",
  "description": "Cross-platform PDF and verse reader bindings for React and Expo with synchronized audio mapping.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "dist/react.d.ts"
      ],
      "react/web": [
        "dist/react-web.d.ts"
      ],
      "react/native": [
        "dist/react-native.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/web": {
      "types": "./react/web.d.ts",
      "browser": "./react/web.js",
      "import": "./react/web.js",
      "require": "./dist/react-web.cjs"
    },
    "./react/web.js": {
      "types": "./react/web.d.ts",
      "default": "./react/web.js"
    },
    "./react/native": {
      "types": "./react/native.d.ts",
      "react-native": "./react/native.js",
      "import": "./react/native.js",
      "require": "./dist/react-native.cjs"
    },
    "./react/native.js": {
      "types": "./react/native.d.ts",
      "react-native": "./react/native.js",
      "default": "./react/native.js"
    }
  },
  "files": [
    "dist",
    "react"
  ],
  "dependencies": {
    "page-flip": "^2.0.7"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && node --test test/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='dist/**' test/*.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "demo:dev": "npm run build && npm --prefix demo run dev",
    "demo:build": "npm run build && npm --prefix demo run build",
    "demo:preview": "npm --prefix demo run preview"
  },
  "keywords": [
    "pdf",
    "reader",
    "flipbook",
    "audio-sync",
    "react"
  ],
  "peerDependencies": {
    "@dr.pogodin/react-native-static-server": ">=0.28.0",
    "@expo/vector-icons": ">=14",
    "expo-audio": ">=1",
    "expo-file-system": ">=17",
    "expo-linking": ">=7",
    "pdfjs-dist": ">=4",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "@dr.pogodin/react-native-static-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "react-dom": "^19.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.6.3"
  }
}
